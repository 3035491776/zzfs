# Flask secrets
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_here

# Database
DB_USER=root
DB_PASS=your_database_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_library
# Comma-separated database names allowed to receive capacity capture writes.
CAPACITY_CAPTURE_ALLOWED_DATABASES=smart_library_phase13_test_20260819_1
# Comma-separated database names allowed to receive metric snapshot writes.
METRIC_RUN_ALLOWED_DATABASES=smart_library_phase13_test_20260819_1

# DeepSeek AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# Baidu Map
BAIDU_MAP_AK=your_baidu_map_ak_here
